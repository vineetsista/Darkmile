# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://darkmile:darkmile@localhost:5432/darkmile"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── OpenAI (optional — app works without it using mock responses) ────────────
OPENAI_API_KEY=""

# ─── Resend (optional — for email briefings) ──────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="briefings@darkmile.io"

# ─── Mapbox (optional — SVG fallback map shown without this) ─────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to bypass auth and use mock data (no DB required)
DEMO_MODE="true"
